cat << 'EOF' > ~/backups-rotatorios-atlas/config/backup.conf
# ==========================================================
# Configuracion del Sistema de Respaldo Rotatorio ATLAS
# ==========================================================

# Directorio a respaldar (Origen)
DIR_ORIGEN=$HOME/proyecto_atlas"

# Directorio donde se guardaran las copias (Destino)
DIR_DESTINO="$HOME/backups_rotatorios-atlas/backups"

# Archivo de registro de eventos
DIR_DESTINO="$HOME/backups-rotatorios-atlas/logs/ejecucion.log"

# Politica de retencion (Eliminar respaldos con mas de N dias)
DIAS_RETENCION=7

# Umbral critico de uso de disco en % antes de abortar el backup
UMBRAL_DISCO_MAX=90
EOF
